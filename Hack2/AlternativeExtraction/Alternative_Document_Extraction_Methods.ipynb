   "source": [
    "## Method 2: Template-Based Extraction\n",
    "\n",
    "This method uses predefined coordinate templates for specific form types like I-9."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class TemplateExtractor:\n",
    "    \"\"\"Template-based extractor using predefined coordinates\"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        # I-9 Form field templates (coordinates in percentage of page)\n",
    "        self.i9_template = {\n",
    "            'last_name': {'x': 0.15, 'y': 0.25, 'width': 0.25, 'height': 0.03},\n",
    "            'first_name': {'x': 0.45, 'y': 0.25, 'width': 0.25, 'height': 0.03},\n",
    "            'middle_initial': {'x': 0.75, 'y': 0.25, 'width': 0.1, 'height': 0.03},\n",
    "            'address': {'x': 0.15, 'y': 0.30, 'width': 0.7, 'height': 0.03},\n",
    "            'city': {'x': 0.15, 'y': 0.35, 'width': 0.3, 'height': 0.03},\n",
    "            'state': {'x': 0.5, 'y': 0.35, 'width': 0.15, 'height': 0.03},\n",
    "            'zip_code': {'x': 0.7, 'y': 0.35, 'width': 0.15, 'height': 0.03},\n",
    "            'date_of_birth': {'x': 0.15, 'y': 0.40, 'width': 0.2, 'height': 0.03},\n",
    "            'ssn': {'x': 0.4, 'y': 0.40, 'width': 0.2, 'height': 0.03},\n",
    "            'email': {'x': 0.65, 'y': 0.40, 'width': 0.2, 'height': 0.03},\n",
    "            'phone': {'x': 0.15, 'y': 0.45, 'width': 0.2, 'height': 0.03}\n",
    "        }\n",
    "        \n",
    "        # Generic form template\n",
    "        self.generic_template = {\n",
    "            'name': {'x': 0.1, 'y': 0.2, 'width': 0.4, 'height': 0.05},\n",
    "            'phone': {'x': 0.1, 'y': 0.3, 'width': 0.3, 'height': 0.05},\n",
    "            'email': {'x': 0.1, 'y': 0.4, 'width': 0.4, 'height': 0.05},\n",
    "            'address': {'x': 0.1, 'y': 0.5, 'width': 0.6, 'height': 0.05}\n",
    "        }\n",
    "    \n",
    "    def extract_from_pdf(self, pdf_path: str, form_type: str = \"i9\") -> Dict[str, ExtractedField]:\n",
    "        \"\"\"Extract data using template coordinates\"\"\"\n",
    "        try:\n",
    "            print(f\"📋 Template Extraction: Processing {os.path.basename(pdf_path)} as {form_type} form\")\n",
    "            \n",
    "            # Select template based on form type\n",
    "            template = self.i9_template if form_type == \"i9\" else self.generic_template\n",
    "            \n",
    "            # Convert PDF to images\n",
    "            images = self._pdf_to_images(pdf_path)\n",
    "            \n",
    "            extracted_fields = {}\n",
    "            \n",
    "            for page_num, image in enumerate(images):\n",
    "                print(f\"   📄 Processing page {page_num + 1}\")\n",
    "                \n",
    "                page_height, page_width = image.shape[:2]\n",
    "                \n",
    "                for field_name, coords in template.items():\n",
    "                    # Convert percentage coordinates to pixel coordinates\n",
    "                    x = int(coords['x'] * page_width)\n",
    "                    y = int(coords['y'] * page_height)\n",
    "                    w = int(coords['width'] * page_width)\n",
    "                    h = int(coords['height'] * page_height)\n",
    "                    \n",
    "                    # Extract region of interest\n",
    "                    roi = image[y:y+h, x:x+w]\n",
    "                    \n",
    "                    # Apply OCR to the region\n",
    "                    text = self._extract_text_from_region(roi)\n",
    "                    \n",
    "                    if text and len(text.strip()) > 1:\n",
    "                        confidence = self._calculate_template_confidence(field_name, text)\n",
    "                        \n",
    "                        if confidence > 0.6:\n",
    "                            field_type = self._determine_field_type(field_name)\n",
    "                            \n",
    "                            extracted_fields[field_name] = ExtractedField(\n",
    "                                name=field_name,\n",
    "                                value=text.strip(),\n",
    "                                confidence=confidence,\n",
    "                                field_type=field_type,\n",
    "                                coordinates=(x, y, w, h),\n",
    "                                extraction_method=\"Template\"\n",
    "                            )\n",
    "            \n",
    "            print(f\"   ✅ Extracted {len(extracted_fields)} fields using Template method\")\n",
    "            return extracted_fields\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"   ❌ Template Extractor Error: {e}\")\n",
    "            return {}\n",
    "    \n",
    "    def _pdf_to_images(self, pdf_path: str, dpi: int = 300) -> List[np.ndarray]:\n",
    "        \"\"\"Convert PDF pages to images\"\"\"\n",
    "        images = []\n",
    "        \n",
    "        try:\n",
    "            doc = fitz.open(pdf_path)\n",
    "            \n",
    "            for page_num in range(len(doc)):\n",
    "                page = doc[page_num]\n",
    "                \n",
    "                # Convert to image\n",
    "                mat = fitz.Matrix(dpi/72, dpi/72)\n",
    "                pix = page.get_pixmap(matrix=mat)\n",
    "                img_data = pix.tobytes(\"png\")\n",
    "                \n",
    "                # Convert to OpenCV format\n",
    "                nparr = np.frombuffer(img_data, np.uint8)\n",
    "                image = cv2.imdecode(nparr, cv2.IMREAD_COLOR)\n",
    "                images.append(image)\n",
    "            \n",
    "            doc.close()\n",
    "            return images\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"PDF to image conversion error: {e}\")\n",
    "            return []\n",
    "    \n",
    "    def _extract_text_from_region(self, roi: np.ndarray) -> str:\n",
    "        \"\"\"Extract text from a specific region using OCR\"\"\"\n",
    "        try:\n",
    "            # Preprocess the region\n",
    "            gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)\n",
    "            thresh = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)[1]\n",
    "            \n",
    "            # Apply OCR\n",
    "            text = pytesseract.image_to_string(thresh, config='--psm 8')\n",
    "            return text.strip()\n",
    "            \n",
    "        except Exception as e:\n",
    "            return \"\"\n",
    "    \n",
    "    def _calculate_template_confidence(self, field_name: str, text: str) -> float:\n",
    "        \"\"\"Calculate confidence for template-extracted text\"\"\"\n",
    "        base_confidence = 0.8  # Higher base confidence for template method\n",
    "        \n",
    "        # Validate based on field type\n",
    "        if field_name == 'phone' and re.match(r'\\(?[0-9]{3}\\)?[-\\.\\s]?[0-9]{3}[-\\.\\s]?[0-9]{4}', text):\n",
    "            return 0.95\n",
    "        elif field_name == 'email' and '@' in text and '.' in text:\n",
    "            return 0.95\n",
    "        elif field_name == 'ssn' and re.match(r'[0-9]{3}[-\\s][0-9]{2}[-\\s][0-9]{4}', text):\n",
    "            return 0.95\n",
    "        elif field_name in ['date_of_birth'] and re.match(r'[0-9]{1,2}[/\\-][0-9]{1,2}[/\\-][0-9]{2,4}', text):\n",
    "            return 0.90\n",
    "        \n",
    "        # Reduce confidence for very short or very long text\n",
    "        if len(text) < 2:\n",
    "            base_confidence *= 0.3\n",
    "        elif len(text) > 100:\n",
    "            base_confidence *= 0.7\n",
    "        \n",
    "        return base_confidence\n",
    "    \n",
    "    def _determine_field_type(self, field_name: str) -> FieldType:\n",
    "        \"\"\"Determine field type from field name\"\"\"\n",
    "        type_mapping = {\n",
    "            'phone': FieldType.PHONE,\n",
    "            'email': FieldType.EMAIL,\n",
    "            'ssn': FieldType.SSN,\n",
    "            'date_of_birth': FieldType.DATE,\n",
    "            'address': FieldType.ADDRESS,\n",
    "            'first_name': FieldType.TEXT,\n",
    "            'last_name': FieldType.TEXT,\n",
    "            'middle_initial': FieldType.TEXT,\n",
    "            'city': FieldType.TEXT,\n",
    "            'state': FieldType.TEXT,\n",
    "            'zip_code': FieldType.TEXT\n",
    "        }\n",
    "        return type_mapping.get(field_name, FieldType.TEXT)"
   ]
